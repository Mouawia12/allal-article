# ملاحظة مهمة: المفاتيح الاختيارية تبقى معلّقة (#) ما دامت بلا قيمة.
# تعريف مفتاح بقيمة فارغة يتجاوز القيمة الافتراضية في application.yaml
# ويُفشل إقلاع التطبيق. أزل # فقط عند وضع قيمة حقيقية.
# ─── Platform Owner ───────────────────────────────────────────────────────────
PLATFORM_OWNER_PASSWORD=ChangeMe@2026!

# ─── Local PostgreSQL ─────────────────────────────────────────────────────────
# قاعدة البيانات تعمل محليًا عبر Homebrew:
#   brew services start postgresql@16
DB_HOST=localhost
DB_PORT=5432
DB_NAME=allal_article
DB_URL=jdbc:postgresql://localhost:5432/allal_article
DB_USERNAME=allal_user
DB_PASSWORD=allal_pass@39
DB_POOL_SIZE=10

# ─── Test Database ────────────────────────────────────────────────────────────
# قاعدة منفصلة للاختبارات — لا تشارك بيانات التطوير
TEST_DB_URL=jdbc:postgresql://localhost:5432/allal_article_test
TEST_DB_USERNAME=allal_user
TEST_DB_PASSWORD=allal_pass@39

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003
APP_PUBLIC_URL=http://localhost:3000

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-local-development-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ─── Brevo SMTP ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=9d2b6b001@smtp-brevo.com
# ⬇️ الصق هنا مفتاح SMTP بعد إنشائه من Brevo (يُعرض مرة واحدة فقط!)
#MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@souftech.com
MAIL_FROM_NAME=ALLAL-ARTICLE

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=allal-article
#R2_PUBLIC_URL_PREFIX=

# ─── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_ACCESS_TOKEN=

# ─── AI Services ─────────────────────────────────────────────────────────────
#OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
#ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
